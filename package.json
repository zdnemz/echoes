{
  "name": "echoes",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "dev:realtime": "bun --hot mini-services/realtime-service/index.ts",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js",
    "start:realtime": "NODE_ENV=production bun mini-services/realtime-service/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:seed": "bun scripts/seed.ts",
    "db:smoke": "bun scripts/smoke-openapi.ts",
    "stack:start": "bash scripts/dev-stack/start.sh",
    "stack:stop": "bash scripts/dev-stack/stop.sh",
    "stack:status": "bash scripts/dev-stack/status.sh",
    "stack:reset": "bash scripts/dev-stack/reset.sh",
    "stack:e2e": "bun scripts/dev-stack/scripts/e2e-realtime.ts && bun scripts/dev-stack/scripts/e2e-invite.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@scalar/hono-api-reference": "^0.12.1",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.82.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.2",
    "hono": "^4.13.7",
    "next": "^16.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{js,mjs,json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
