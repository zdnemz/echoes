# Echoes — example environment.
#
# Copy to .env and fill in. The app boots (build, lint, dev, CI) even when
# these are absent: requests that need a missing value fail with 503 instead
# of crashing the process.

# ---------------------------------------------------------------- app
# Public base URL, used to build invite-accept links.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------- supabase
# Required for anything that touches the database or auth.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
# Service role — needed for rate limiting, the reflect cache (Postgres
# backend), invite tokens and webhooks. Optional: without it the app
# degrades to per-instance in-memory stores.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------- reflect (AI companion)
# Any OpenAI-compatible or Anthropic-compatible endpoint. The key never
# reaches the browser. AI_API_KEY/AI_ENTRYPOINT/AI_MODEL are the canonical
# names; the provider-specific ones below are read as fallbacks.
AI_API_KEY=your-api-key
AI_ENTRYPOINT=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Optional: "anthropic" when the endpoint is Anthropic's /messages API.
# AI_PROVIDER=anthropic

# Provider-specific fallbacks (only used when the canonical name is unset):
# OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL
# ANTHROPIC_API_KEY / ANTHROPIC_MODEL
# OPENROUTER_API_KEY / OPENROUTER_MODEL

# ---------------------------------------------------------------- reflect cache
# Optional. Pointing this at Redis serves cached reflections from Redis
# instead of the reflect_cache Postgres table. Unset = Postgres when the
# service role is available, else a per-process in-memory map.
# REDIS_URL=redis://127.0.0.1:6379
# Optional. How long a cached reply is served before the model is asked
# again. Defaults to 168 (7 days).
# REFLECT_CACHE_TTL_HOURS=168

# ---------------------------------------------------------------- deployment
# Read-only signals set by the platform, not by you:
#   NODE_ENV  — next/vercel
#   VERCEL    — enables Vercel-specific rate-limit handling
# Trusted proxies in front of the app. 0 (default) ignores X-Forwarded-For
# as attacker-controlled; set to the number of your own proxies (e.g. 1
# behind your own nginx/Caddy) so client IPs resolve correctly.
# TRUSTED_PROXY_HOPS=0

# ---------------------------------------------------------------- local stack only
# Used by scripts/dev-stack/* to reach the local Postgres directly.
# PG_PORT=5432
